xCell id="add_n97" value="&lt;div align=&quot;center&quot;&gt;&lt;font color=&quot;#00B050&quot; style=&quot;font-size:12.0px&quot;&gt;N97: NSACF in other PLMN&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;align=left;" parent="1" vertex="1"><mxGeometry as="geometry" x="1291.9" y="1771.9" width="206.7" height="20.7" /></mxCell><mxCell id="add_n99" value="&lt;div align=&quot;center&quot;&gt;&lt;font color=&quot;#00B050&quot; style=&quot;font-size:12.0px&quot;&gt;N99: NSACF in same PLMN&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;align=left;" parent="1" vertex="1"><mxGeometry as="geometry" x="1291.9" y="1794.4" width="206.7" height="20.7" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#00B050;strokeWidth=1.61;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=12.0;fontColor=#00B050;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="o614" target="add_n97"><mxGeometry as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#00B050;strokeWidth=1.61;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=12.0;fontColor=#00B050;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="o614" target="add_n99"><mxGeometry as="geometry" /></mxCell><mxCell id="add_nupf" value="&lt;div align=&quot;center&quot;&gt;&lt;font color=&quot;#00B050&quot; style=&quot;font-size:12.0px&quot;&gt;Nupf&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00B050;fontFamily=Arial;fontSize=12.0;fontColor=#00B050;" parent="1" vertex="1"><mxGeometry as="geometry" x="1640.7" y="1163.0" width="48.6" height="21.9" /></mxCell><mxCell id="ftr_r18" value="&lt;div align=&quot;left&quot;&gt;&lt;font color=&quot;#00B050&quot; style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Release-18 additions (green):&lt;/b&gt; N89 (TSCTSF-AMF), N96 (TSCTSF-NRF), N97/N99 (NSACF inter/intra-PLMN), Nupf (UPF SBI), NCR (TS 38.300 Cl.4.9); functional additions: 5.47 NCR, 5.20b-d, 5.28a, 5.35A MBSR, 5.43-5.46, eRedCap, DetNet, XR.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="30.0" y="2041.7" width="3260.0" height="62.0" /></mxCell><mxCell id="ftr_r19" value="&lt;div align=&quot;left&quot;&gt;&lt;font color=&quot;#0070C0&quot; style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Release-19 additions (blue):&lt;/b&gt; EIF (TS 23.501 Cl.6.2.34) with N110-N114 and Neif; N116 (SCP-NWDAF), N117 (SCP-DCCF), Nscp; Ambient IoT: AIOTF / ADM / AIoT Device with AIOT1-AIOT8 (TS 23.369); NR Femto (Cl.5.50); functional additions: 4.2.18 EE architecture, 5.48, 5.49 MWAB, 5.51, 5.52, sidelink multi-hop, LP-WUS/WUR, SBFD, AI/ML for NR air interface.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="30.0" y="2109.7" width="3260.0" height="62.0" /></mxCell><mxCell id="ftr_note" value="&lt;div align=&quot;left&quot;&gt;&lt;font color=&quot;#404040&quot; style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Colour note:&lt;/b&gt; inside the original figure, green already means Release-16 and blue Release-17; the Release-18 (green) / Release-19 (blue) additions reuse the same hues by series policy. Added elements are the ones listed above and in composite-drawio-notes.md. This is a DRAFT for review.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="30.0" y="2177.7" width="3260.0" height="62.0" /></mxCell></root></mxGraphModel></diagram></mxfile>