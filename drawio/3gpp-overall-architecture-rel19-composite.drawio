n=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="2722.3" width="4346.7" height="82.7" /></mxCell><mxCell id="ftr_r19" value="&lt;div align=&quot;left&quot;&gt;&lt;font color=&quot;#0070C0&quot; style=&quot;font-size:26.7px&quot;&gt;&lt;b&gt;Release-19 additions (blue):&lt;/b&gt; EIF (TS 23.501 Cl.6.2.34) with N110-N114 and Neif; N116 (SCP-NWDAF), N117 (SCP-DCCF), Nscp; Ambient IoT: AIOTF / ADM / AIoT Device with AIOT1-AIOT8 (TS 23.369); NR Femto (Cl.5.50); functional additions: 4.2.18 EE architecture, 5.48, 5.49 MWAB, 5.51, 5.52, sidelink multi-hop, LP-WUS/WUR, SBFD, AI/ML for NR air interface.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="2813.0" width="4346.7" height="82.7" /></mxCell><mxCell id="ftr_note" value="&lt;div align=&quot;left&quot;&gt;&lt;font color=&quot;#404040&quot; style=&quot;font-size:26.7px&quot;&gt;&lt;b&gt;Colour note:&lt;/b&gt; inside the original figure, green already means Release-16 and blue Release-17; the Release-18 (green) / Release-19 (blue) additions reuse the same hues by series policy. Added elements are the ones listed above and in composite-drawio-notes.md. This is a DRAFT for review.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="2903.6" width="4346.7" height="82.7" /></mxCell></root></mxGraphModel></diagram></mxfile>